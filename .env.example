# Development only. Do not commit a real .env file.
APP_ENV=development
# Address used by Streamlit to call FastAPI. In ECS this becomes the internal API URL.
API_BASE_URL=http://127.0.0.1:8000

# Langfuse: leave tracing disabled until your hospital approves observability data flows.
# Never enable capture of patient-identifiable prompts or outputs.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Future open-source model server using an OpenAI-compatible API.
OPEN_SOURCE_MODEL_BASE_URL=http://localhost:8001/v1
OPEN_SOURCE_MODEL_NAME=replace-with-approved-model
# Only required when your approved model server requires authentication.
OPEN_SOURCE_MODEL_API_KEY=

# DynamoDB is deliberately disabled until you provide this value in development
# and the ECS task role is granted access in AWS.
DYNAMODB_TABLE_NAME=
AWS_REGION=eu-west-2
# `synthetic` keeps automated tests and first-run development offline.
# Set this to `dynamodb` only after your development table and AWS SSO profile work.
PATIENT_DATA_MODE=synthetic

# Future approved medication-information provider. Do not configure a public
# source for clinical use; use a licensed provider approved by pharmacy/legal.
MEDICATION_API_BASE_URL=
MEDICATION_API_KEY=
# Set only after the DynamoDB component has been verified. OpenFDA is a public
# US drug-label data source, not a substitute for approved local formulary data.
MEDICATION_API_ENABLED=false
