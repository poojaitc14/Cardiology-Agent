# Application
APP_ENV=local
LOG_LEVEL=INFO
REFERENCE_DATE=2026-08-17

# Repository providers
PATIENT_REPOSITORY_PROVIDER=local_json
POLICY_RETRIEVER_PROVIDER=local
MEDICATION_ORDER_PROVIDER=unavailable
LLM_PROVIDER=openai
OPENFDA_PROVIDER=openfda

# Feature flags (cloud adapters inactive by default)
ENABLE_DYNAMODB=false
ENABLE_OPENSEARCH=false
ENABLE_LANGFUSE=false

# Paths (relative to repo root)
PATIENTS_JSON_PATH=data/patients/runtime/patients.json
CASE_MANIFEST_PATH=data/patients/evaluation/case_manifest.json
CORPUS_INVENTORY_PATH=config/corpus_inventory.yaml
LOCAL_INDEX_PATH=.local/policy_index.json
AUDIT_LOG_PATH=.local/audit.log

# API
API_HOST=127.0.0.1
API_PORT=8000
# Local Streamlit (host machine)
STREAMLIT_API_URL=http://127.0.0.1:8000
# Docker Compose Streamlit container (service hostname)
API_BASE_URL=http://api:8000

# OpenAI (optional — fake LLM used when absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# openFDA (optional — fake client used when absent)
OPENFDA_API_KEY=

# DynamoDB (when ENABLE_DYNAMODB=true)
AWS_REGION=eu-west-2
DYNAMODB_PATIENTS_TABLE=Patients

# OpenSearch Serverless (when ENABLE_OPENSEARCH=true)
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=cardiology-policies

# Langfuse (when ENABLE_LANGFUSE=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
