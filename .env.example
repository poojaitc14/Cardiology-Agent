# AWS authentication is supplied by the standard AWS credential provider chain
# (for example, an IAM role, AWS profile, or CI workload identity). Do not put
# access keys in this file or commit a real .env file.
AWS_REGION=eu-west-2
DYNAMODB_PATIENT_TABLE=PatientClinicalRecords

# OpenFDA Configuration
# OpenFDA API key (optional but recommended for higher rate limits)
# Get your key from: https://open.fda.gov/apis/authentication/
# Leave empty to use the public API without authentication
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
OPENFDA_TIMEOUT_SECONDS=10

# Azure OpenAI Configuration
# Get credentials from: https://portal.azure.com
# API key for authentication
AZURE_OPENAI_API_KEY=

# Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=

# API version (e.g., 2024-08-01-preview)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# GPT 4.1 mini deployment name for answer generation
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Text embedding 3 small deployment name for document embeddings
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Embedding model name
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenSearch RAG configuration -- an AWS OpenSearch Serverless collection (VECTORSEARCH
# type). No username/password: every request is signed with AWS SigV4 using the same
# credential chain as DynamoDB above, so AWS_REGION must also be set correctly.
# Bare hostname only, no scheme -- e.g. abc123xyz.eu-west-2.aoss.amazonaws.com
OPENSEARCH_HOST=
OPENSEARCH_INDEX=cardiology-approved-documents
RAG_EMBEDDING_DIMENSIONS=1536

# Langfuse Observability Configuration
# Get your keys from: https://cloud.langfuse.com
# Enable or disable Langfuse observability (default: true)
LANGFUSE_ENABLED=true

# Langfuse public key (required if LANGFUSE_ENABLED=true)
# Do NOT commit real keys to version control
LANGFUSE_PUBLIC_KEY=pk_...

# Langfuse secret key (required if LANGFUSE_ENABLED=true)
# Do NOT commit real keys to version control
LANGFUSE_SECRET_KEY=sk_...

# Langfuse host (default: https://cloud.langfuse.com)
LANGFUSE_HOST=https://cloud.langfuse.com

# API Configuration
LOG_LEVEL=INFO
CORS_ORIGINS=*

# simple change v2